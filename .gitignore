node_modules
dist
.DS_Store
*.local
.env
.env.*
!.env.example

# Plaintext caseload. Contains client information and must never be committed.
# Only public/caseload.enc.json, the encrypted form, belongs in this repo.
# The whole directory is ignored rather than named files: a .bak or a rename
# is exactly how the plaintext would otherwise slip through. Anchored with a
# leading slash so it means this directory and not every directory called data:
# unanchored, it also swallowed src/data and left the app unbuildable from a
# fresh clone.
/data/

# Test screenshots
tests/shots

# Netlify CLI link state (local only)
.netlify

# Home-screen icons are generated by scripts/gen-icons.mjs on every build.
public/icon-*.png

# Netlify local state
.netlify

# Throwaway debug scripts. Named with a leading underscore so they never
# survive into a commit the way one already did.
_*.mjs
_*.js

# Preview build output, published to the gh-pages branch rather than tracked.
dist-preview
